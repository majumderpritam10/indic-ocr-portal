# Copy this file to secrets.toml (same folder) and fill in your values. secrets.toml is git-ignored.

# Best option, free, no credit card: key from https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-key-here"

# Optional: any real email address raises the MyMemory daily free limit (used only as a fallback)
MYMEMORY_EMAIL = "your.email@example.com"

# Optional, only if you ever get an Azure Translator key:
# AZURE_TRANSLATOR_KEY = "paste-key-1-here"
# AZURE_TRANSLATOR_REGION = "centralindia"
